# Explicit v2 provider configuration. Never commit .env or credential values.
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
NULLLAB_MODEL=muse-spark-1.3
NULLLAB_MODEL_CRITIC=muse-wonder-1.0
NULLLAB_REASONING_EFFORT=low
NULLLAB_MAX_TOKENS=12000
NULLLAB_TIMEOUT_S=90
NULLLAB_RETRIES=1
# For local compatible inference use http://127.0.0.1:8080/v1,
# your served model ID, blank key, and blank reasoning effort if unsupported.
# NULLLAB_ALLOW_WEB_LIVE=1 must be set in the server environment to enable web calls.
