# Copy to .env (gitignored) and add your own key. Never commit .env or credential values.
# Environment variables take precedence over this file.
# Leave MODEL_API_KEY blank to stay in the default rules mode (no model calls).

# OpenAI-compatible chat endpoint.
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=

# Planner and optional critic model IDs.
NULLLAB_MODEL=muse-spark-1.3
NULLLAB_MODEL_CRITIC=muse-wonder-1.0

NULLLAB_REASONING_EFFORT=low
NULLLAB_MAX_TOKENS=12000
NULLLAB_TIMEOUT_S=90
NULLLAB_RETRIES=1

# For a local compatible server use MODEL_BASE_URL=http://127.0.0.1:8080/v1,
# your served model ID, a blank key, and a blank NULLLAB_REASONING_EFFORT if unsupported.

# Server-side opt-in that lets the web UI make live model calls:
# NULLLAB_ALLOW_WEB_LIVE=1
