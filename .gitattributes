* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.pdf binary
*.woff binary
*.woff2 binary

# Preserve the exact bytes of the tested recording UI and upload fixtures.
# Their source/provenance identities must survive a fresh Git checkout.
agent/engine.py -text whitespace=cr-at-eol
app/server.py -text whitespace=cr-at-eol
app/static/** -text whitespace=cr-at-eol
test-materials/workdesk/** -text whitespace=cr-at-eol
# Keep the upstream license texts verbatim, including their whitespace.
app/static/fonts/*-OFL.txt -whitespace
